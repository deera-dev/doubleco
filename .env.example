# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Client-side (VITE_ prefix = bundled into the browser build) ---
# Only ever put PUBLIC values behind VITE_. Anything here ends up
# readable in the shipped JS bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Optional until photo uploads ship
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# development | staging | production
VITE_APP_ENV=development

# --- Server-only (NO VITE_ prefix = never bundled, never sent to the browser) ---
# Vite does not expose these to import.meta.env at all. They only exist
# for a future Supabase Edge Function / Vercel serverless function.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@your-cloud-name
